# ==============================================================================
# 幼安雷達 — 環境變數設定範本 (.env.example)
#
# 使用方式：
#   cp .env.example .env
#   並在 .env 中填入實際設定值
#
# ⚠️ 安全提醒：
#   .env 已由 .gitignore 排除，請勿將包含真實金鑰的 .env 提交至 Git 倉庫！
# ==============================================================================

# AWS 區域設定 (黑客松競賽指定區域：us-west-2 或 us-east-1)
AWS_DEFAULT_REGION=us-west-2
AWS_REGION=us-west-2

# AWS Bedrock 模型設定 (預設使用 Amazon Nova Pro，備用 Nova Lite)
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_FALLBACK_MODEL_ID=us.amazon.nova-lite-v1:0

# AWS 憑證由 IAM Instance Profile 或本機 AWS Profile 提供。
# 不要把 Access Key、Secret Key 或 Session Token 寫入專案檔案。

# 私有文件儲存與短效下載（infra/private-artifacts.yaml）
YOUAN_ARTIFACT_BUCKET=replace-with-private-bucket-name
YOUAN_PRESIGN_TTL_SECONDS=300

# 伺服器監聽埠號 (預設 8088，由 Nginx 反向代理)
PORT=8088

# ==============================================================================
# AWS RDS PostgreSQL 資料庫持久化設定 (取代本地 SQLite)
# ==============================================================================
# RDS_HOST=youan-radar-pg.c7...us-west-2.rds.amazonaws.com
# RDS_PORT=5432
# RDS_DB_NAME=youan_radar
# RDS_USER=youan_admin
# RDS_PASSWORD=
# RDS_SSLMODE=require

          "text": "1.2",
          "rowSpan": 1,
          "colSpan": 1,
          "header": false
        },
        {
          "text": "生師比例",
          "rowSpan": 1,
          "colSpan": 1,
          "header": false
        },
        {
          "text": "1.2.1",
          "rowSpan": 1,
          "colSpan": 1,
          "header": false
        },
        {
          "text": "生師比例應符合幼兒教育及照顧法之規定。",
          "rowSpan": 1,
          "colSpan": 1,
          "header": false
        },
        {
          "text": "V",
          "rowSpan": 1,
          "colSpan": 1,
          "header": false
        },
        {
          "text": "",
          "rowSpan": 1,
          "colSpan": 1,
          "header": false
        },
        {
          "text": "",
          "rowSpan": 1,

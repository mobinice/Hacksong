          "header": false
        }
      ],
      [
        {
          "text": "5.2.3",
          "rowSpan": 1,
          "colSpan": 1,
          "header": false
        },
        {
          "text": "應建立幼兒託藥措施，並告知家長。",
          "rowSpan": 1,
          "colSpan": 1,
          "header": false
        },
        {
          "text": "V",
          "rowSpan": 1,
          "colSpan": 1,
          "header": false
        },
        {
          "text": "",
          "rowSpan": 1,
          "colSpan": 1,
